# ==========================================
# PC Web Monitor - Environment Configuration
# ==========================================

# Secret key used for signing and verifying JWT tokens (Auth Service & Backend)
# Generate a secure key (e.g., `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://192.168.0.186:3000

# Cookie security flag (set to 'true' if running over HTTPS, 'false' for HTTP homelab setups)
SECURE_COOKIES=false

# Initial password for the master admin account (used by auth-service/create_admin.py)
INIT_HASH_PASSWORD=change_this_to_a_secure_password

# ------------------------------------------
# Optional / Defaults
# ------------------------------------------
# HOST=0.0.0.0
# PORT=8001
# Comma-separated container prefixes to hide from dashboard (default: pc_web_monitor-)
# HIDDEN_CONTAINERS=pc_web_monitor-
# Metrics history recording interval in seconds (default: 10)
# METRICS_RECORD_INTERVAL=10
# Metrics history retention in days (default: 14)
# METRICS_RETENTION_DAYS=14
