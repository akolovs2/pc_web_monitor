[Unit]
Description=PC Monitor Backend
After=network.target

[Service]
User=akolovs2
WorkingDirectory=/srv/docker/pc_web_monitor/backend
ExecStart=/srv/docker/pc_web_monitor/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3
EnvironmentFile=/srv/docker/pc_web_monitor/.env

[Install]
WantedBy=multi-user.target
